# Migrações revisadas ficam diretamente no diretório e começam por AAAAMMDD_.
!database/migrations/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_*.sql
!tests/auth/fixtures/*.sql
# Cópias identificadas continuam ignoradas, inclusive nos diretórios liberados.
*[Dd][Uu][Mm][Pp]*.sql
*[Bb][Aa][Cc][Kk][Uu][Pp]*.sql
*[Ss][Nn][Aa][Pp][Ss][Hh][Oo][Tt]*.sql
*.sqlite
*.sqlite3
*.db
