		<wsdl:operation name="responderComunicacao">
			<wsdl:documentation>
Operação destinada a permitir a resposta a ato de comunicação processual. 
			</wsdl:documentation>
			<wsdl:input message="tic:requisicaoResponderComunicacao"></wsdl:input>
