		</wsdl:operation>
		<wsdl:operation name="remeterProcesso">
			<wsdl:documentation>
Operação destinada a permitir a remessa de processo. 
			</wsdl:documentation>
			<wsdl:input message="tic:requisicaoRemeterProcesso"></wsdl:input>
			<wsdl:output message="tic:respostaRemeterProcesso"></wsdl:output>
		</wsdl:operation>
		<wsdl:operation name="consultarAlteracao">
			<wsdl:documentation>
Operação destinada a permitir uma verificação rápida quanto à existência de modificações havidas 
em um processo judicial. 
			</wsdl:documentation>
			<wsdl:input message="tic:requisicaoConsultarAlteracao"></wsdl:input>
			<wsdl:output message="tic:respostaConsultarAlteracao"></wsdl:output>
		</wsdl:operation>
		<wsdl:operation name="confirmarRecebimento">
			<wsdl:documentation>
Operação destinada a permitir que um tribunal recebedor de um processo enviado confirme o integral 
recebimento junto ao tribunal remetente 
			</wsdl:documentation>
			<wsdl:input message="tic:requisicaoConfirmarRecebimento"></wsdl:input>
			<wsdl:output message="tic:respostaConfirmarRecebimento"></wsdl:output>
		</wsdl:operation>
		<wsdl:operation name="consultarLocalidades">
			<wsdl:documentation>
