#!/bin/sh
set -eu

# After every user commit, bump VERSION and amend the commit so VERSION (and any
# generated release files) are part of the same commit.

if [ "${SKIP_VERSION_BUMP:-}" = "1" ]; then
  exit 0
fi

commit_msg="$(git log -1 --pretty=%B)"
first_line="$(printf "%s" "$commit_msg" | sed -n '1p' | tr -d '\r')"
commit_msg_lower="$(printf "%s" "$commit_msg" | tr '[:upper:]' '[:lower:]')"

case "$first_line" in
  Merge*) exit 0 ;;
esac

case "$commit_msg_lower" in
  *"[skip version]"*|*"[skip-version]"*) exit 0 ;;
esac

type="$(printf "%s" "$first_line" | sed -nE 's/^([a-z]+)(\([^)]+\))?:.*/\1/p')"
[ -n "$type" ] || type="patch"

# Count files in the commit excluding hook-managed files (VERSION + release docs)
# so bump logic isn't skewed by the automation itself.
file_count="$(git diff-tree --no-commit-id --name-only -r HEAD | sed '/^$/d' | grep -Ev '^(VERSION|CHANGELOG\.md|docs/releases/)' | wc -l | tr -d ' ')"
file_count="${file_count:-0}"

# Resolve bump kind (priority: explicit tags).
bump=""
case "$commit_msg_lower" in
  *"[major]"*) bump="major" ;;
  *"[minor]"*) bump="minor" ;;
  *"[patch2000]"*|*"[refactor]"*) bump="patch2000" ;;
  *"[patch8000]"*|*"[hotfix]"*) bump="patch8000" ;;
  *"[patch]"*) bump="patch" ;;
esac

if [ -z "$bump" ]; then
  if [ "$type" = "release" ]; then
    bump="major"
  elif [ "$file_count" -gt 100 ] 2>/dev/null; then
    bump="minor"
  else
    case "$type" in
      feat|ux|refactor|perf) bump="minor" ;;
      *) bump="patch" ;;
    esac
  fi
fi

powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/bump-version.ps1 -CommitMessage "$commit_msg" -Bump "$bump" -FileCount "$file_count" >/dev/null 2>&1 || true

git add VERSION CHANGELOG.md docs/releases/_draft_minor.md docs/releases/v*.md >/dev/null 2>&1 || true

if git diff --cached --quiet; then
  exit 0
fi

# Keep VERSION changes in the same commit (rewrites hash).
SKIP_VERSION_BUMP=1 SKIP_DRAFT_UPDATE=1 git commit --amend --no-edit --no-verify >/dev/null 2>&1 || true
