#!/bin/sh
set -eu

# After every user commit, create a follow-up commit that updates
# docs/releases/_draft_minor.md. This avoids amending the user's commit and keeps
# the commit hash referenced in the draft stable.

if [ "${SKIP_VERSION_BUMP:-}" = "1" ]; then
  exit 0
fi

commit_hash="$(git rev-parse --short HEAD)"
commit_msg="$(git log -1 --pretty=%B)"
first_line="$(printf "%s" "$commit_msg" | sed -n '1p' | tr -d '\r')"
commit_msg_lower="$(printf "%s" "$commit_msg" | tr '[:upper:]' '[:lower:]')"

case "$first_line" in
  Merge*) exit 0 ;;
esac

case "$commit_msg_lower" in
  *"[skip version]"*|*"[skip-version]"*) exit 0 ;;
esac

case "$commit_msg_lower" in
  *"[skip draft]"*|*"[skip-draft]"*|*"[skip release-notes]"*) exit 0 ;;
esac

type="$(printf "%s" "$first_line" | sed -nE 's/^([a-z]+)(\([^)]+\))?:.*/\1/p')"
[ -n "$type" ] || type="patch"

# Count files in the commit excluding hook-managed files (VERSION + release docs)
# so bump logic isn't skewed by the automation itself.
file_count="$(git diff-tree --no-commit-id --name-only -r HEAD | sed '/^$/d' | grep -Ev '^(VERSION|CHANGELOG\.md|docs/releases/)' | wc -l | tr -d ' ')"
file_count="${file_count:-0}"

# Resolve bump kind (priority: explicit tags).
bump=""
case "$commit_msg_lower" in
  *"[major]"*) bump="major" ;;
  *"[minor]"*) bump="minor" ;;
  *"[patch2000]"*|*"[refactor]"*) bump="patch2000" ;;
  *"[patch8000]"*|*"[hotfix]"*) bump="patch8000" ;;
  *"[patch]"*) bump="patch" ;;
esac

if [ -z "$bump" ]; then
  if [ "$type" = "release" ]; then
    bump="major"
  elif [ "$file_count" -gt 100 ] 2>/dev/null; then
    bump="minor"
  else
    case "$type" in
      feat|ux|refactor|perf) bump="minor" ;;
      *) bump="patch" ;;
    esac
  fi
fi

if [ "${SKIP_DRAFT_UPDATE:-}" != "1" ] && [ -f "docs/releases/_draft_minor.md" ]; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/update-draft-minor.ps1 -CommitHash "$commit_hash" -CommitMessage "$commit_msg" -Bump "$bump" >/dev/null 2>&1 || true
fi

git add docs/releases/_draft_minor.md >/dev/null 2>&1 || true

if git diff --cached --quiet; then
  exit 0
fi

# Disable custom hooks for this automation commit, otherwise the version-bump
# hook would run again.
git_dir="$(git rev-parse --git-dir 2>/dev/null || echo ".git")"
: > "${git_dir}/.skip-version-bump" 2>/dev/null || true
git -c core.hooksPath=.git/hooks commit -m "chore(release-notes): atualizar draft (for ${commit_hash}) [skip version] [skip draft]" --no-verify >/dev/null 2>&1 || true
rm -f "${git_dir}/.skip-version-bump" >/dev/null 2>&1 || true
