#!/bin/sh
set -eu

if [ "${SKIP_VERSION_BUMP:-}" = "1" ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
git_dir="$(git rev-parse --git-dir 2>/dev/null || echo "$repo_root/.git")"
log_file="$git_dir/version-bump.log"

bump_ps1="$repo_root/scripts/bump-version.ps1"
draft_ps1="$repo_root/scripts/update-draft-minor.ps1"

[ -f "$bump_ps1" ] || bump_ps1="$repo_root/bump-version.ps1"
[ -f "$draft_ps1" ] || draft_ps1="$repo_root/update-draft-minor.ps1"

log_ps_error() {
  {
    printf "\n[%s] %s\n" "$(date '+%Y-%m-%d %H:%M:%S')" "$1"
    if [ -f "$2" ]; then
      cat "$2"
      printf "\n"
    fi
  } >> "$log_file"
}

run_powershell_logged() {
  label="$1"
  shift

  tmp="$(mktemp 2>/dev/null || printf '%s' "$repo_root/.git/.tmp-version-bump.$$")"
  # shellcheck disable=SC2068
  powershell.exe -NoProfile -ExecutionPolicy Bypass $@ >"$tmp" 2>&1
  rc=$?
  if [ "$rc" -ne 0 ]; then
    log_ps_error "$label (exit=$rc)" "$tmp"
  fi
  rm -f "$tmp" 2>/dev/null || true
  return 0
}

commit_msg="$(git log -1 --pretty=%B)"
first_line="$(printf "%s" "$commit_msg" | sed -n '1p' | tr -d '\r')"
commit_msg_lower="$(printf "%s" "$commit_msg" | tr '[:upper:]' '[:lower:]')"

case "$first_line" in
  Merge*) exit 0 ;;
esac

case "$commit_msg_lower" in
  *"[skip version]"*|*"[skip-version]"*) exit 0 ;;
esac

commit_hash="$(git rev-parse --short HEAD)"
commit_date="$(date '+%Y-%m-%d %H:%M:%S')"

type="$(printf "%s" "$first_line" | sed -nE 's/^([a-z]+)(\([^)]+\))?:.*/\1/p' | tr '[:upper:]' '[:lower:]')"
[ -n "$type" ] || type="patch"

# --- métricas do commit ---
file_count="$(git diff-tree --no-commit-id --name-only -r HEAD \
  | sed '/^$/d' \
  | grep -Ev '^(VERSION|CHANGELOG\.md|docs/90-releases/notes/)' \
  | wc -l | tr -d ' ')"
file_count="${file_count:-0}"

# insertions/deletions (aprox)
stats_line="$(git show --shortstat --format= HEAD | tail -n 1 | tr -d '\r')"
ins="$(printf "%s" "$stats_line" | sed -nE 's/.* ([0-9]+) insertions?\(\+\).*/\1/p')"
del="$(printf "%s" "$stats_line" | sed -nE 's/.* ([0-9]+) deletions?\(-\).*/\1/p')"
[ -n "$ins" ] || ins="0"
[ -n "$del" ] || del="0"

# checar áreas sensíveis (para impacto)
changed_paths="$(git diff-tree --no-commit-id --name-only -r HEAD | tr -d '\r')"

touch_security="0"
printf "%s" "$changed_paths" | grep -Eq '^(config/|docs/30-security/|app/middlewares/|app/controllers/|database/|scripts/)' && touch_security="1"
only_docs="0"
printf "%s" "$changed_paths" | grep -Eq '^[^d]' >/dev/null 2>&1 || true
# "only docs" se todos os arquivos começam com docs/
if printf "%s" "$changed_paths" | sed '/^$/d' | grep -Eqv '^docs/'; then
  only_docs="0"
else
  only_docs="1"
fi

# --- impacto automático ---
impact="baixo"
# nenhum: só docs e alterações pequenas
if [ "$only_docs" = "1" ] && [ "$file_count" -le 5 ] && [ "$ins" -le 80 ] && [ "$del" -le 80 ]; then
  impact="nenhum"
# alto: grandes mudanças, ou áreas sensíveis e grandes mudanças
elif [ "$file_count" -ge 40 ] || [ "$ins" -ge 800 ] || [ "$del" -ge 400 ]; then
  impact="alto"
elif [ "$touch_security" = "1" ] && ( [ "$file_count" -ge 15 ] || [ "$ins" -ge 300 ] || [ "$del" -ge 150 ] ); then
  impact="alto"
# médio
elif [ "$file_count" -ge 15 ] || [ "$ins" -ge 300 ] || [ "$del" -ge 150 ] || [ "$touch_security" = "1" ]; then
  impact="medio"
fi

# --- bump automático ---
# prioridade: tags explícitas
bump=""
case "$commit_msg_lower" in
  *"[major]"*|*"[release]"*) bump="major" ;;
  *"[minor]"*) bump="minor" ;;
  *"[patch2000]"*|*"[refactor]"*) bump="patch2000" ;;
  *"[patch8000]"*|*"[hotfix]"*) bump="patch8000" ;;
  *"[patch]"*) bump="patch" ;;
esac

# se não tem tag, decide por tipo + impacto
if [ -z "$bump" ]; then
  if [ "$type" = "release" ]; then
    bump="major"
  else
    # regra: impacto médio/alto ou tipos "feat/ux/refactor/perf" => minor; senão patch
    if [ "$impact" = "medio" ] || [ "$impact" = "médio" ] || [ "$impact" = "alto" ]; then
      bump="minor"
    else
      case "$type" in
        feat|ux|refactor|perf) bump="minor" ;;
        *) bump="patch" ;;
      esac
    fi
  fi
fi

#
# 1) Atualiza VERSION/CHANGELOG via bump-version.ps1 e amenda o commit.
#
if [ -f "$bump_ps1" ]; then
  run_powershell_logged "bump-version.ps1 failed" \
    -File "$bump_ps1" -CommitMessage "$commit_msg" -Bump "$bump" -FileCount "$file_count"
else
  log_ps_error "bump-version.ps1 not found at: $bump_ps1" "/dev/null"
fi

# Stage arquivos gerenciados (inclui drafts e notes quando existirem)
git add VERSION CHANGELOG.md >/dev/null 2>&1 || true
git add docs/90-releases/_draft_minor.md docs/90-releases/_draft_major.md >/dev/null 2>&1 || true
git add docs/90-releases/notes/*.md >/dev/null 2>&1 || true

# Amend commit para incluir VERSION/CHANGELOG e eventuais artefatos gerados
if ! git diff --cached --quiet; then
  git -c core.hooksPath=.git/hooks commit --amend --no-edit --no-verify >/dev/null 2>&1 || true
fi

# Recalcula hash após amend
commit_hash="$(git rev-parse --short HEAD)"

#
# 2) Atualiza drafts e gera notes conforme bump
#
case "$commit_msg_lower" in
  *"[skip draft]"*|*"[skip-draft]"*|*"[skip release-notes]"*) exit 0 ;;
esac

if [ -f "$draft_ps1" ]; then
  run_powershell_logged "update-draft-minor.ps1 failed" \
    -File "$draft_ps1" \
    -RepoRoot "$repo_root" \
    -CommitHash "$commit_hash" \
    -CommitMessage "$commit_msg" \
    -Bump "$bump" \
    -Impact "$impact"
else
  log_ps_error "update-draft-minor.ps1 not found at: $draft_ps1" "/dev/null"
fi

# Stage drafts/notes gerados pelo script
git add docs/90-releases/_draft_minor.md docs/90-releases/_draft_major.md >/dev/null 2>&1 || true
git add docs/90-releases/notes/*.md >/dev/null 2>&1 || true

# Commit separado só se tiver algo novo a registrar (evita ruído)
if git diff --cached --quiet; then
  exit 0
fi

git -c core.hooksPath=.git/hooks commit -m "chore(release-notes): atualizar drafts/notes ($commit_hash $commit_date) [skip version] [skip draft]" --no-verify >/dev/null 2>&1 || true
