#!/bin/sh
set -eu

# Always bump VERSION as part of the user's commit.

if [ "${SKIP_VERSION_BUMP:-}" = "1" ]; then
  exit 0
fi

git_dir="$(git rev-parse --git-dir 2>/dev/null || echo ".git")"
if [ -f "${git_dir}/.skip-version-bump" ]; then
  exit 0
fi

# Skip during merge commits.
if [ -f "${git_dir}/MERGE_HEAD" ]; then
  exit 0
fi

file_count="$(git diff --cached --name-only | sed '/^$/d' | grep -Ev '^(VERSION|CHANGELOG\.md|docs/releases/)' | wc -l | tr -d ' ')"
file_count="${file_count:-0}"

powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/bump-version.ps1 -CommitMessage "" -FileCount "$file_count" >/dev/null 2>&1 || true
git add VERSION CHANGELOG.md docs/releases/v*.md >/dev/null 2>&1 || true

