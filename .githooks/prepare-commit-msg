#!/bin/sh
set -eu

# Ensure VERSION is updated as part of the user's commit.
# Draft release notes are handled in post-commit (needs the commit hash).

if [ "${SKIP_VERSION_BUMP:-}" = "1" ]; then
  exit 0
fi

git_dir="$(git rev-parse --git-dir 2>/dev/null || echo ".git")"
if [ -f "${git_dir}/.skip-version-bump" ]; then
  exit 0
fi

msg_file="${1:-}"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  exit 0
fi

commit_msg="$(cat "$msg_file")"
first_line="$(printf "%s" "$commit_msg" | sed -n '1p' | tr -d '\r')"
commit_msg_lower="$(printf "%s" "$commit_msg" | tr '[:upper:]' '[:lower:]')"

case "$first_line" in
  Merge*) exit 0 ;;
esac

case "$commit_msg_lower" in
  *"[skip version]"*|*"[skip-version]"*) exit 0 ;;
esac

# Count user-staged files excluding hook-managed paths.
file_count="$(git diff --cached --name-only | sed '/^$/d' | grep -Ev '^(VERSION|CHANGELOG\.md|docs/releases/)' | wc -l | tr -d ' ')"
file_count="${file_count:-0}"

powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/bump-version.ps1 -CommitMessage "$commit_msg" -FileCount "$file_count" >/dev/null 2>&1 || true

# Stage files that bump-version.ps1 may touch (VERSION, and release docs on MINOR).
git add VERSION CHANGELOG.md docs/releases/v*.md >/dev/null 2>&1 || true
