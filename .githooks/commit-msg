# .git/hooks/commit-msg.ps1
# =============================================================================
# GIT HOOK: commit-msg (PowerShell)
# =============================================================================
param([string]$MsgFile)

$ErrorActionPreference = 'Stop'

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES
# -----------------------------------------------------------------------------
$ALLOWED_TYPES = "feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|release"
$MIN_DESC_LENGTH = 10
$DEBUG = [bool]$env:DEBUG

# Cores
$RED = "`e[0;31m"
$GREEN = "`e[0;32m"
$YELLOW = "`e[1;33m"
$NC = "`e[0m"

# -----------------------------------------------------------------------------
# FUNÇÕES AUXILIARES
# -----------------------------------------------------------------------------
function Write-Error-Exit {
    param([string]$msg)
    Write-Host "${RED}ERRO:${NC} $msg" -ForegroundColor Red
    exit 1
}

function Write-Warn {
    param([string]$msg)
    Write-Host "${YELLOW}AVISO:${NC} $msg" -ForegroundColor Yellow
}

function Write-Debug-Info {
    param([string]$msg)
    if ($DEBUG) {
        Write-Host "${GREEN}DEBUG:${NC} $msg" -ForegroundColor Green
    }
}

# -----------------------------------------------------------------------------
# INÍCIO DA VALIDAÇÃO
# -----------------------------------------------------------------------------
if (-not $MsgFile -or -not (Test-Path $MsgFile)) {
    exit 0
}

Write-Debug-Info "Arquivo de mensagem: $MsgFile"

$msg = Get-Content $MsgFile -Raw -ErrorAction SilentlyContinue
if (-not $msg) {
    Write-Error-Exit "Mensagem de commit vazia."
}

Write-Debug-Info "Mensagem original: $msg"

$firstLine = ($msg -split "`n")[0].Trim()
Write-Debug-Info "Primeira linha: $firstLine"

$lower = $msg.ToLower()

# -----------------------------------------------------------------------------
# EXCEÇÕES
# -----------------------------------------------------------------------------
if ($firstLine -match '^Merge') {
    Write-Debug-Info "Commit de merge detectado - pulando validação"
    exit 0
}

if ($lower -match '|$skip[-\s]?version$|') {
    Write-Warn "Validação ignorada por [skip version]"
    exit 0
}

# -----------------------------------------------------------------------------
# EXTRAÇÃO DO TIPO
# -----------------------------------------------------------------------------
if ($firstLine -match '^([a-z]+)(|$[^)]+$|)?(!)?:\s*(.*)$') {
    $type = $matches[1].ToLower()
    $desc = $matches[4].Trim()
} else {
    Write-Error-Exit @"
Padrão de commit inválido. Use: tipo(escopo): descrição

Exemplos válidos:
  feat(auth): adicionar login OAuth
  fix: corrigir validação de CPF
  docs(readme): atualizar instruções

Se quiser ignorar versionamento, use [skip version].
Guia: https://www.conventionalcommits.org/
"@
}

Write-Debug-Info "Tipo extraído: '$type'"
Write-Debug-Info "Descrição extraída: '$desc'"

# -----------------------------------------------------------------------------
# VALIDAÇÃO DO TIPO
# -----------------------------------------------------------------------------
if ($type -notmatch "^($ALLOWED_TYPES)$") {
    Write-Error-Exit @"
Tipo de commit '$type' não é permitido.

Tipos válidos: $ALLOWED_TYPES
Exemplo: feat(api): adicionar endpoint de usuários
"@
}

# -----------------------------------------------------------------------------
# VALIDAÇÃO ESPECIAL: release
# -----------------------------------------------------------------------------
if ($type -eq 'release' -and $lower -notmatch '|$(release|major)$|') {
    Write-Error-Exit @"
Commits do tipo 'release' exigem tag [release] ou [major].
Exemplo: release: preparar versão 2.0.0 [major]
"@
}

# -----------------------------------------------------------------------------
# VALIDAÇÃO DE MENSAGENS GENÉRICAS
# -----------------------------------------------------------------------------
$genericRe = '^(update|upd|wip|teste|test|fix|ajustes|mudancas|alteracoes|commit|changes|update code|fix bug)$'
$descLower = $desc.ToLower().Trim()

if ($descLower -match $genericRe) {
    Write-Error-Exit @"
Mensagem muito genérica: '$desc'

Use algo descritivo, como:
  fix: corrigir validação do formulário de login
  feat: adicionar busca por nome no relatório

Se for intencional, adicione [skip version].
"@
}

if ($desc.Length -lt $MIN_DESC_LENGTH) {
    Write-Error-Exit @"
Descrição muito curta ($($desc.Length) caracteres). Mínimo: $MIN_DESC_LENGTH.
Descrição atual: '$desc'

Use uma descrição mais detalhada do que foi alterado.
"@
}

# -----------------------------------------------------------------------------
# VALIDAÇÃO DE TAGS
# -----------------------------------------------------------------------------
$allowedTagRe = '^|$(major|release|minor|patch\d*|hotfix|refactor|skip[-\s]?version|skip[-\s]?draft|skip release-notes|security|deprecated|removed|impact:(nenhum|baixo|medio|alto))$|$'
$tags = [regex]::Matches($msg, '|$[^$|]+$|') | ForEach-Object { $_.Value }

foreach ($tag in $tags) {
    $tagLower = $tag.ToLower()
    Write-Debug-Info "Validando tag: $tagLower"

    if ($tagLower -notmatch $allowedTagRe) {
        Write-Error-Exit @"
Tag inválida detectada: $tag

Tags de versionamento permitidas:
  [major] [release] [minor] [patch] [patch2000] [hotfix] [refactor]

Tags de controle:
  [skip version] [skip-version] [skip draft] [skip release-notes]

Tags especiais:
  [security] [deprecated] [removed]

Tags de impacto:
  [impact:nenhum] [impact:baixo] [impact:medio] [impact:alto]
"@
    }
}

# -----------------------------------------------------------------------------
# SUCESSO
# -----------------------------------------------------------------------------
Write-Debug-Info "Mensagem de commit validada com sucesso!"
exit 0
