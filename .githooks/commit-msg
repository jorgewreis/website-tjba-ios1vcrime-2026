#!/bin/sh
set -eu

MSG_FILE="${1:-}"
[ -n "$MSG_FILE" ] || exit 0
[ -f "$MSG_FILE" ] || exit 0

msg="$(cat "$MSG_FILE" 2>/dev/null || true)"
first_line="$(printf "%s" "$msg" | sed -n '1p' | tr -d '\r')"
lower="$(printf "%s" "$msg" | tr '[:upper:]' '[:lower:]')"

# Allow merge commits
case "$first_line" in
  Merge*) exit 0 ;;
esac

# Skip validation if user explicitly opts out
case "$lower" in
  *"[skip version]"*|*"[skip-version]"*) exit 0 ;;
esac

# Parse type: type(scope): desc OR type: desc
type="$(printf "%s" "$first_line" | sed -nE 's/^([a-z]+)(\([^)]+\))?:.*/\1/p' | tr '[:upper:]' '[:lower:]')"
[ -n "$type" ] || type="patch"

# 1) release requires explicit [release] or [major]
if [ "$type" = "release" ]; then
  echo "$lower" | grep -q "\[release\]\|\[major\]" || {
    echo "ERRO: commits do tipo 'release' exigem tag [release] ou [major]." >&2
    echo "Ex.: release: preparar versão X [release]" >&2
    exit 1
  }
fi

# 2) block very generic messages (unless skip version)
# Keep this list short and truly low-signal.
generic_re='^(update|upd|wip|teste|test|fix|ajustes|mudanças|alterações|commit)$'
desc="$(printf "%s" "$first_line" | sed -nE 's/^[a-z]+(\([^)]+\))?:[[:space:]]*(.*)$/\2/p' | tr -d '\r')"
desc_lc="$(printf "%s" "$desc" | tr '[:upper:]' '[:lower:]' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"

if printf "%s" "$desc_lc" | grep -Eq "$generic_re"; then
  echo "ERRO: mensagem muito genérica ('$desc')." >&2
  echo "Use algo descritivo, ex.: 'fix: corrigir validação do formulário'." >&2
  echo "Se for intencional, adicione [skip version]." >&2
  exit 1
fi

# 3) validate bracket-tags (bump + control tags)
# Extract tags like [xxx] from entire message
# Allowed:
#  - major, release, minor, patch, patch2000, patch8000, hotfix, refactor
#  - skip version, skip-version, skip draft, skip-draft, skip release-notes
#  - security, deprecated, removed
#  - impact:nenhum|baixo|medio|médio|alto
allowed_tag_re='^\[(major|release|minor|patch|patch2000|patch8000|hotfix|refactor|skip version|skip-version|skip draft|skip-draft|skip release-notes|security|deprecated|removed|impact:(nenhum|baixo|medio|m[eé]dio|alto))\]$'

# shell-only extraction
# Iterate all [..] tokens
tags="$(printf "%s" "$msg" | tr '\r' '\n' | grep -o '\[[^]]\+\]' 2>/dev/null || true)"

if [ -n "$tags" ]; then
  echo "$tags" | while IFS= read -r t; do
    tl="$(printf "%s" "$t" | tr '[:upper:]' '[:lower:]')"
    printf "%s" "$tl" | grep -Eq "$allowed_tag_re" || {
      echo "ERRO: tag inválida detectada: $t" >&2
      echo "Tags permitidas: [major] [release] [minor] [patch] [patch2000] [patch8000] [hotfix] [refactor]" >&2
      echo "Controle: [skip version] [skip draft] [skip release-notes] e [impact:...]" >&2
      exit 1
    }
  done
fi

exit 0
