#!/bin/sh
# Wrapper para executar o hook em PowerShell no Windows

# Detecta o caminho do script PowerShell
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PS_SCRIPT="$SCRIPT_DIR/commit-msg.ps1"

# Executa o PowerShell passando os argumentos
exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$PS_SCRIPT" "$@"
