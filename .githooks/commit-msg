#!/bin/sh
set -eu

# Auto-bump VERSION based on the commit message.
# Rules (priority order):
# - Tags override: [major]/[minor]/[patch]/[patch2000]/[patch8000]/[refactor]/[hotfix]
# - type "release" => major bump
# - >100 files staged => minor bump
# - type feat/ux/refactor/perf => minor bump
# - otherwise => patch bump (0001-1999)

if [ "${SKIP_VERSION_BUMP:-}" = "1" ]; then
  exit 0
fi

msg_file="${1:-}"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  exit 0
fi

first_line="$(sed -n '1p' "$msg_file" | tr -d '\r')"
case "$first_line" in
  Merge*) exit 0 ;;
esac

commit_msg="$(cat "$msg_file")"
commit_msg_lower="$(printf "%s" "$commit_msg" | tr '[:upper:]' '[:lower:]')"

bump=""
case "$commit_msg_lower" in
  *"[major]"*) bump="major" ;;
  *"[minor]"*) bump="minor" ;;
  *"[patch2000]"*|*"[refactor]"*) bump="patch2000" ;;
  *"[patch8000]"*|*"[hotfix]"*) bump="patch8000" ;;
  *"[patch]"*) bump="patch" ;;
esac

type="$(printf "%s" "$first_line" | sed -nE 's/^([a-z]+)(\([^)]+\))?:.*/\1/p')"
[ -n "$type" ] || type="patch"

if [ -z "$bump" ]; then
  if [ "$type" = "release" ]; then
    bump="major"
  else
    file_count="$(git diff --cached --name-only | sed '/^$/d' | wc -l | tr -d ' ')"
    file_count="${file_count:-0}"
    if [ "$file_count" -gt 100 ] 2>/dev/null; then
      bump="minor"
    else
      case "$type" in
        feat|ux|refactor|perf) bump="minor" ;;
        *) bump="patch" ;;
      esac
    fi
  fi
fi

version_file="VERSION"
if [ ! -f "$version_file" ]; then
  printf "%s\n" "V 1.00.0000" > "$version_file"
fi

raw="$(tr -d '\r' < "$version_file")"
raw="$(printf "%s" "$raw" | sed -E 's/^[Vv][[:space:]]+//')"

major="$(printf "%s" "$raw" | cut -d. -f1)"
minor="$(printf "%s" "$raw" | cut -d. -f2)"
patch="$(printf "%s" "$raw" | cut -d. -f3)"

major="$(printf "%s" "${major:-1}" | sed -E 's/[^0-9].*$//')"
minor="$(printf "%s" "${minor:-0}" | sed -E 's/[^0-9].*$//')"
patch="$(printf "%s" "${patch:-0}" | sed -E 's/[^0-9].*$//')"

[ -n "$major" ] || major=1
[ -n "$minor" ] || minor=0
[ -n "$patch" ] || patch=0

major_n=$((10#$major))
minor_n=$((10#$minor))
patch_n=$((10#$patch))

case "$bump" in
  major)
    major_n=$((major_n + 1))
    minor_n=0
    patch_n=0
    ;;
  minor)
    minor_n=$((minor_n + 1))
    patch_n=0
    ;;
  patch2000)
    if [ "$patch_n" -lt 2000 ]; then
      patch_n=2000
    else
      patch_n=$((patch_n + 1))
    fi
    ;;
  patch8000)
    if [ "$patch_n" -lt 8000 ]; then
      patch_n=8000
    else
      patch_n=$((patch_n + 1))
    fi
    ;;
  *)
    if [ "$patch_n" -lt 1 ]; then
      patch_n=1
    else
      patch_n=$((patch_n + 1))
    fi
    ;;
esac

if [ "$minor_n" -gt 99 ]; then
  minor_n=0
  major_n=$((major_n + 1))
  patch_n=0
fi

new_version="$(printf "V %d.%02d.%04d" "$major_n" "$minor_n" "$patch_n")"
current_version="$(tr -d '\r' < "$version_file")"
if [ "$new_version" = "$current_version" ]; then
  exit 0
fi

printf "%s\n" "$new_version" > "$version_file"

git_dir="$(git rev-parse --git-path .)"
printf "%s\n" "$new_version" > "$git_dir/version-bump"
