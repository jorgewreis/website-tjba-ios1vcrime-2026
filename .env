# --- Configurações do Banco de Dados (MySQL / CloudPanel) ---
DB_HOST=localhost
DB_NAME=nome_do_banco
DB_USER=usuario_do_banco
DB_PASS=senha_segura_do_banco
DB_PORT=3306
DB_CHARSET=utf8mb4

# --- Configurações da Aplicação ---
APP_ENV=local
# Defina como 'false' em produção para não expor erros na tela
APP_DEBUG=true
APP_URL=http://ios1vcrime.com.br
# Fuso horário para logs e registros (Ilhéus/Bahia)
APP_TIMEZONE=America/Bahia

# --- Segurança e Autenticação (JWT) ---
# Chave secreta para assinar os tokens (use uma string longa e aleatória)
JWT_SECRET=sua_chave_secreta_super_complexa_aqui_123456
# Tempo de expiração do token em segundos (6 horas = 21600 segundos)
JWT_EXPIRATION=21600
# Algoritmo de criptografia padrão
JWT_ALGO=HS256

# --- Configurações de E-mail (Recuperação de Senha) ---
MAIL_HOST=smtp.exemplo.com
MAIL_PORT=587
MAIL_USER=jorgew.reis@outlook.com
MAIL_PASS=sua_senha_de_email
MAIL_FROM_NAME="SGC - Ios1vCrime"
MAIL_FROM_ADDRESS=no-reply@ios1vcrime.com.br
