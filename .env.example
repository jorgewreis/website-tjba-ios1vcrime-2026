APP_ENV=production
APP_DEBUG=0
APP_URL=https://example.com
APP_TIMEZONE=America/Bahia

DB_HOST=127.0.0.1
DB_NAME=database_name
DB_USER=database_user
DB_PASS=database_password
DB_PORT=3306
DB_CHARSET=utf8mb4

JWT_SECRET=change-me
JWT_EXPIRATION=28800
JWT_ALGO=HS256

MAIL_DRIVER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=mail_user
MAIL_PASS=mail_password
MAIL_FROM_NAME=Sistema
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_ENCRYPTION=tls
# E-mail semanal réus presos / reavaliação. Agendamento no SO (quinta 18h): ver scripts/register-*.ps1 e install-cron-*.sh
GABINETE_REUS_PRESOS_EMAIL_REVISAO_TO=jorgew.reis@outlook.com
GABINETE_REUS_PRESOS_EMAIL_REVISAO_BCC=
GABINETE_REUS_PRESOS_EMAIL_REVISAO_HORIZONTE_DIAS=15

DATAJUD_API_KEY=replace-with-datajud-api-key
# Opcional: base da API pública (padrão https://api-publica.datajud.cnj.jus.br)
DATAJUD_BASE_URL=
# Índice padrão quando o número CNJ não mapear (ex.: tjba) e para segunda tentativa de busca
DATAJUD_DEFAULT_ALIAS=tjba
MAINTENANCE_UNTIL=

# 1 = validar reutilização contra historico_senha no reset por link (requer trigger no BD). 0 = desativar.
# A alteração de senha logada usa a constante PASSWORD_HISTORY_ON_CHANGE_ENABLED em config/config.php.
PASSWORD_HISTORY_CHECK=1

ROOT_USER=
ROOT_PASS=
GIT_USER=
GIT_LOCAL=
